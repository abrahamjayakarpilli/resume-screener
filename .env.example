# TalentLens AI Environment Settings

# Server Config
PORT=8000
HOST=127.0.0.1

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./talentlens.db

# LLM Providers Configuration
# If MOCK_LLM is true, the system works completely offline without API calls (excellent for demoing)
MOCK_LLM=true
GEMINI_API_KEY=
OPENAI_API_KEY=

# Configurable Deterministic Match Weights (Must sum to 1.0)
SCORING_WEIGHT_TECH=0.40
SCORING_WEIGHT_EXP=0.30
SCORING_WEIGHT_PROJ=0.15
SCORING_WEIGHT_EDU=0.10
SCORING_WEIGHT_OTHER=0.05
